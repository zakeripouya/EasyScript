let k be 0
while k is less than 3:
    add 1 to k
say k
as long as k is greater than 0:
    subtract 1 from k
say k
keep doing this until k is 2:
    increase k by 1
say k
repeat until k is 0:
    decrease k by 1
say k
repeat while k is less than 1:
    add 1 to k
say k
repeat until yes:
    say "never: until is checked before each round"
while no:
    say "never"
