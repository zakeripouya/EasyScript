note: value forms that leave something out: "L without item N", "T without character N", "M without K"
let scores be a list of 72, 95 and 88
say scores without item 2
say scores
let grid be a list of (a list of 1) and (a list of 2 and 3)
let g2 be grid without item 1
add 9 to the end of item 1 of g2
say grid
say g2
say "café!" without character 4
say "abc" without character 1
let ages be a map of "Ada" to 36, "Bob" to 20 and "Cy" to 5
let younger be ages without "Bob"
say younger
say ages
let who be "Cy"
say (ages without who) without "Ada"
let many be a map of "x" to (a list of 1)
