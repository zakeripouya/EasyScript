count from 1 to 3:
    say number
count from 3 to 1 as n:
    say n
count from 0 to 1 by 0.25 and call each number x:
    say x
count from 0 to 1 in steps of 0.1:
    if number is 1, say "lands exactly on 1"
count from 1 to 10 by 4:
    say it
count from 5 to 5:
    say "once"
count down from 2 to 0:
    say "down " followed by it
count down from 1 to 3:
    say "never"
go from 0 to 20 in steps of 10:
    say it
for each i from 1 to 2:
    say "each " followed by i
let limit be "3"
count from 1 to (limit as a number) as n:
    say n
let start be 2
let finish be 4
count from start to finish:
    set finish to 100
    say it
