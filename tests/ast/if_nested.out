if [1:1]
  branch if [1:1]
    condition
      name p [1:4]
    then
      if [2:5]
        branch if [2:5]
          condition
            name q [2:8]
          then
            say [3:9]
              text "p and q" [3:13]
        branch otherwise [4:5]
          then
            say [5:9]
              text "p, not q" [5:13]
      if (one line) [6:5]
        branch if [6:5]
          condition
            name r [6:8]
          then
            say [6:11]
              text "r too" [6:15]
  branch otherwise [7:1]
    then
      if [8:5]
        branch if [8:5]
          condition
            name q [8:8]
          then
            say [9:9]
              text "q only" [9:13]
      say [12:5]
        text "done" [12:9]
