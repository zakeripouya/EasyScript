let x be 1
otherwise:
    say "no if"
if x is 1:
    say "one"
    otherwise:
        say "indented too far"
if x is 1, say "one line".
otherwise:
    say "after one-line if"
if x is 1:
    say "a"
otherwise:
    say "b"
otherwise:
    say "second otherwise"
if x is 1:
    say "a"
otherwise, say "one-line otherwise"
if x is 1:
    say "a"
else if:
    say "missing condition"
say "end"
