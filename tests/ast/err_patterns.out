record customer [1:3]
  field name (kind from use) [1:18]
  field price (kind from use) [1:29]
record product [2:3]
  field name (kind from use) [2:17]
  field price (kind from use) [2:28]
define give a customer a discount of some percent (customer: a customer, percent) [3:1]
  do
    multiply field [4:5]
      field
        field price [4:16]
          name customer [4:16]
      divide [4:40]
        subtract [4:40]
          number 100 [4:40]
          name percent [4:40]
        number 100 [4:40]
define give a product a discount of some amount (product: a product, amount) [5:1]
  do
    subtract field [6:5]
      field
        field price [6:16]
          name product [6:16]
      name amount [6:39]
define thank a customer for some reason (customer: a customer, reason) [14:1]
  do
    say [15:5]
      text "thanks" [15:9]
define greet a customer (customer: a customer) [20:1]
  do
    say [21:5]
      text "hi" [21:9]
define introduce a customer to another customer (customer: a customer, other customer: a customer) [23:1]
  do
    say [24:5]
      text "hello" [24:9]
