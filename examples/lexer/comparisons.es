# Lexer example: `easyscript tokens` shows how this is read.
# Comparison symbols: = != < > <= >=
if total = 10:
    say "ten".
if total != 10:
    say "not ten".
if total < 10:
    say "less than ten".
if total > 10:
    say "more than ten".
if total <= 10:
    say "at most ten".
if total >= 10:
    say "at least ten".
