note: Joining text and turning values into text.
let name be "Ada"
let age be 36
say "Hello,", name, "!"
say "[name] is [age]."
say name followed by " is " followed by age followed by "."
say "Name length:", length of name
say "Brackets in text: [[like this]]"
say "41" as a number plus 1
say "Sum: " followed by 2 plus 3
